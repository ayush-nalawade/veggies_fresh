{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "ES2020"
        ],
        "baseUrl": "./",
        "paths": {
            "*": [
                "src/*"
            ]
        },
        "checkJs": false,
        "moduleResolution": "node"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "logs"
    ]
}